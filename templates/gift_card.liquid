{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% render 'meta-tags' %}
    {% render 'fonts' %}
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>

  <body class="template-gift-card">
    <main class="password-page">
      {% render 'wordmark', width: 150 %}
      <p class="kicker">{{ 'gift_card.title' | t }}</p>
      <p class="display display--md">{{ gift_card.balance | money }}</p>

      {%- if gift_card.enabled == false or gift_card.expired -%}
        <p class="lead">{{ 'gift_card.expired' | t }}</p>
      {%- endif -%}
      {%- if gift_card.expires_on -%}
        {%- assign expires_on = gift_card.expires_on | date: '%d %B %Y' -%}
        <p class="lead">{{ 'gift_card.expires_on' | t: expires_on: expires_on }}</p>
      {%- endif -%}

      <p class="lead">{{ 'gift_card.use_at_checkout' | t }}</p>
      <p class="gift-code">{{ gift_card.code | format_code }}</p>

      {%- if gift_card.pass_url -%}
        <a href="{{ gift_card.pass_url }}">
          <img
            src="{{ 'gift-card/add-to-apple-wallet.svg' | shopify_asset_url }}"
            alt="{{ 'gift_card.add_to_apple_wallet' | t }}"
            width="200"
            height="60"
          >
        </a>
      {%- endif -%}
      <a class="button button--dark" href="{{ shop.url }}">{{ 'cart.continue' | t }}</a>
    </main>
  </body>
</html>
