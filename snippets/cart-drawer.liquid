<div class="drawer" id="CartDrawer" data-cart-drawer hidden>
  <div class="drawer__overlay" data-drawer-close></div>
  <div
    class="drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="CartDrawerTitle"
    tabindex="-1"
  >
    <div class="drawer__head">
      <h2 class="h4" id="CartDrawerTitle">{{ 'cart.title' | t }}</h2>
      <button type="button" class="text-button" data-drawer-close>{{ 'general.close' | t }}</button>
    </div>
    <div class="drawer__body" data-cart-drawer-body>
      {% render 'cart-drawer-contents' %}
    </div>
  </div>
</div>
