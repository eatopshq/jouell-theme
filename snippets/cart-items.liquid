{% doc %}
  Line items for the cart page and cart drawer.

  @param {boolean} [compact] - Drawer layout
{% enddoc %}

<ul class="cart-items{% if compact %} cart-items--compact{% endif %}" role="list">
  {%- for item in cart.items -%}
    <li class="cart-item" data-line-key="{{ item.key }}">
      <a href="{{ item.url }}" class="cart-item__media">
        {%- if item.image -%}
          {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}
        {%- endif -%}
      </a>
      <div class="cart-item__info">
        <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
        {%- unless item.product.has_only_default_variant -%}
          <p class="cart-item__variant">{{ item.variant.title }}</p>
        {%- endunless -%}
        {%- for prop in item.properties -%}
          {%- unless prop.first contains '_' or prop.last == blank -%}
            <p class="cart-item__variant">{{ prop.first }}: {{ prop.last }}</p>
          {%- endunless -%}
        {%- endfor -%}
        <div class="cart-item__row">
          <div class="qty qty--small">
            <button
              type="button"
              data-line-change="{{ item.quantity | minus: 1 }}"
              data-key="{{ item.key }}"
              aria-label="{{ 'products.decrease' | t }}"
            >
              −
            </button>
            <span aria-live="polite">{{ item.quantity }}</span>
            <button
              type="button"
              data-line-change="{{ item.quantity | plus: 1 }}"
              data-key="{{ item.key }}"
              aria-label="{{ 'products.increase' | t }}"
            >
              +
            </button>
          </div>
          <button type="button" class="cart-item__remove" data-line-change="0" data-key="{{ item.key }}">
            {{- 'cart.remove' | t -}}
          </button>
        </div>
      </div>
      <div class="cart-item__price">
        {{ item.final_line_price | money_without_trailing_zeros }}
        {%- if item.original_line_price > item.final_line_price -%}
          <s>{{ item.original_line_price | money_without_trailing_zeros }}</s>
        {%- endif -%}
      </div>
    </li>
  {%- endfor -%}
</ul>
