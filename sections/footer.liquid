<footer class="footer">
  <div class="page-width">
    <div class="footer__top">
      {% render 'wordmark', tone: 'ivory', width: 110, class: 'footer__wordmark' %}

      <div class="footer__cols">
        {%- for block in section.blocks -%}
          <div class="footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <p class="footer__title">{{ block.settings.title }}</p>
            {%- endif -%}
            {%- case block.type -%}
              {%- when 'menu' -%}
                <ul role="list">
                  {%- for link in block.settings.menu.links -%}
                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                  {%- endfor -%}
                </ul>
              {%- when 'text' -%}
                <div class="footer__text">{{ block.settings.text }}</div>
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="footer__bottom">
      <span>&copy; {{ 'now' | date: '%Y' }} {{ section.settings.copyright }}</span>
      {%- if settings.social_instagram != blank
        or settings.social_facebook != blank
        or settings.social_whatsapp != blank
      -%}
        <span class="footer__social">
          {%- if settings.social_instagram != blank -%}
            <a href="{{ settings.social_instagram }}" target="_blank" rel="noopener">Instagram</a>
          {%- endif -%}
          {%- if settings.social_facebook != blank -%}
            <a href="{{ settings.social_facebook }}" target="_blank" rel="noopener">Facebook</a>
          {%- endif -%}
          {%- if settings.social_whatsapp != blank -%}
            <a href="{{ settings.social_whatsapp }}" target="_blank" rel="noopener">WhatsApp</a>
          {%- endif -%}
        </span>
      {%- endif -%}
      <span>{{ section.settings.disclaimer }}</span>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "max_blocks": 5,
  "settings": [
    {
      "type": "text",
      "id": "copyright",
      "label": "Copyright line",
      "default": "Jouell · a subsidiary of Fashionpur India"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "Fashion jewellery in plated alloy. Never sold as gold or hallmarked silver."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "SHOP" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "CONTACT" },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>+91 99587 08555<br>+91 98731 86107<br>jouellindia@gmail.com<br>7 days, 9 am – 7 pm</p>"
        }
      ]
    }
  ],
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
