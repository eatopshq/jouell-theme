{%- liquid
  assign s = section.settings
  assign benchmark_cents = s.benchmark_value | times: 100
-%}

<div class="wedding-week section-pad-top bg-sand" data-wedding-week data-benchmark="{{ benchmark_cents }}">
  <div class="page-width">
    <div class="centered-intro">
      {%- if s.kicker != blank -%}
        <p class="eyebrow">{{ s.kicker }}</p>
      {%- endif -%}
      {%- if s.heading != blank -%}<h2 class="h1">{{ s.heading }}</h2>{%- endif -%}
      {%- if s.text != blank -%}<p class="lead">{{ s.text }}</p>{%- endif -%}
    </div>

    <div class="week-grid" data-mobile-scroll>
      {%- for block in section.blocks -%}
        {%- liquid
          assign option_list = ''
          for i in (1..3)
            assign key = 'product_' | append: i
            assign p = block.settings[key]
            if p != blank
              assign option_list = option_list | append: i | append: ','
            endif
          endfor
          assign options = option_list | split: ','
          assign day_number = forloop.index
        -%}
        <div class="week-card" data-week-day {{ block.shopify_attributes }}>
          <div class="week-card__top">
            <span class="week-card__day">{{ 'sections.wedding_week.day' | t: number: day_number }}</span>
            <span
              class="week-card__count"
              data-week-count
              data-of="{{ 'sections.wedding_week.of' | t }}"
              aria-live="polite"
            >
              {%- if options.size > 0 -%}1 {{ 'sections.wedding_week.of' | t }} {{ options.size }}{%- endif -%}
            </span>
          </div>

          {%- if options.size == 0 -%}
            <div class="week-card__media">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              <div class="week-card__fn">
                <span class="week-card__fn-en">{{ block.settings.function_name }}</span>
                <span class="week-card__fn-hi">{{ block.settings.function_local }}</span>
              </div>
            </div>
            <div class="week-card__body">
              <p class="week-card__name">{{ 'sections.wedding_week.pick_products' | t }}</p>
            </div>
          {%- endif -%}

          {%- for i in options -%}
            {%- liquid
              assign key = 'product_' | append: i
              assign note_key = 'note_' | append: i
              assign p = block.settings[key]
              assign v = p.selected_or_first_available_variant
            -%}
            <div
              class="week-card__option"
              data-week-option
              data-variant-id="{{ v.id }}"
              data-price="{{ v.price }}"
              data-available="{{ v.available }}"
              {% unless forloop.first %}
                hidden
              {% endunless %}
            >
              <a class="week-card__media" href="{{ p.url }}">
                {% render 'responsive-image',
                  image: p.featured_media.preview_image,
                  sizes: '(min-width: 990px) 20vw, 70vw',
                  max_width: 600
                %}
                <div class="week-card__fn">
                  <span class="week-card__fn-en">{{ block.settings.function_name }}</span>
                  <span class="week-card__fn-hi">{{ block.settings.function_local }}</span>
                </div>
              </a>
              <div class="week-card__body">
                <a class="week-card__name" href="{{ p.url }}">{{ p.title | escape }}</a>
                <p class="week-card__note">{{ block.settings[note_key] }}</p>
              </div>
            </div>
          {%- endfor -%}

          <div class="week-card__foot">
            <span class="week-card__price" data-week-price>
              {%- if options.size > 0 -%}
                {%- assign first_key = 'product_' | append: options.first -%}
                {{ block.settings[first_key].selected_or_first_available_variant.price | money_without_trailing_zeros }}
              {%- endif -%}
            </span>
            {%- if options.size > 1 -%}
              <span class="week-card__arrows">
                <button
                  type="button"
                  class="square-button"
                  data-week-prev
                  aria-label="{{ 'sections.wedding_week.previous' | t: day: block.settings.function_name }}"
                >
                  ‹
                </button>
                <button
                  type="button"
                  class="square-button"
                  data-week-next
                  aria-label="{{ 'sections.wedding_week.next' | t: day: block.settings.function_name }}"
                >
                  ›
                </button>
              </span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>

    <div class="week-total">
      <div class="week-total__cell">
        <p class="week-total__label week-total__label--gold">{{ s.total_label }}</p>
        <p class="week-total__value" data-week-total>—</p>
      </div>
      <div class="week-total__cell">
        <p class="week-total__label">{{ s.benchmark_label }}</p>
        <p class="week-total__value week-total__value--muted">{{ benchmark_cents | money_without_trailing_zeros }}</p>
      </div>
      <div class="week-total__cell">
        <p class="week-total__label week-total__label--gold">{{ s.saved_label }}</p>
        <p class="week-total__value" data-week-saved>—</p>
      </div>
      <div class="week-total__cta">
        {%- if s.footnote != blank -%}<p class="week-total__note">{{ s.footnote }}</p>{%- endif -%}
        <button type="button" class="button button--gold" data-week-add>
          {{- s.button_label -}}
        </button>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Wedding week planner",
  "max_blocks": 7,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Small line above heading", "default": "Plan your wedding week" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "A set for every day, planned in one screen" },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Five functions, five different looks — swap any day until the week suits you, and watch it stay under the price of a single gold necklace."
    },
    { "type": "header", "content": "Totals bar" },
    { "type": "text", "id": "total_label", "label": "Total label", "default": "FIVE JOUELL SETS" },
    { "type": "text", "id": "benchmark_label", "label": "Benchmark label", "default": "ONE 22K GOLD NECKLACE" },
    {
      "type": "number",
      "id": "benchmark_value",
      "label": "Benchmark price (₹, whole rupees)",
      "default": 412000,
      "info": "Update this as the gold rate changes."
    },
    { "type": "text", "id": "saved_label", "label": "Savings label", "default": "YOU KEEP" },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "Gold benchmark: 10 g at today's rate with making. Ours is plated alloy — that is the point."
    },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "ADD THE WEEK TO BAG" }
  ],
  "blocks": [
    {
      "type": "day",
      "name": "Function",
      "settings": [
        { "type": "text", "id": "function_name", "label": "Function", "default": "Haldi" },
        { "type": "text", "id": "function_local", "label": "Function (Hindi)", "default": "हल्दी" },
        { "type": "product", "id": "product_1", "label": "Option 1" },
        { "type": "text", "id": "note_1", "label": "Option 1 note", "info": "e.g. Strung beads, 38 g — turmeric wipes clean" },
        { "type": "product", "id": "product_2", "label": "Option 2" },
        { "type": "text", "id": "note_2", "label": "Option 2 note" },
        { "type": "product", "id": "product_3", "label": "Option 3" },
        { "type": "text", "id": "note_3", "label": "Option 3 note" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Wedding week planner",
      "blocks": [
        { "type": "day", "settings": { "function_name": "Haldi", "function_local": "हल्दी" } },
        { "type": "day", "settings": { "function_name": "Mehendi", "function_local": "मेहंदी" } },
        { "type": "day", "settings": { "function_name": "Sangeet", "function_local": "संगीत" } },
        { "type": "day", "settings": { "function_name": "Shaadi", "function_local": "शादी" } },
        { "type": "day", "settings": { "function_name": "Reception", "function_local": "रिसेप्शन" } }
      ]
    }
  ]
}
{% endschema %}
