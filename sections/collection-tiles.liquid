{%- assign s = section.settings -%}

<div class="section-pad-top">
  <div class="page-width">
    {% render 'section-heading',
      kicker: s.kicker,
      heading: s.heading,
      link_label: s.link_label,
      link_url: s.link_url
    %}

    <div class="tiles" style="--cols: {{ s.columns }};" data-mobile-scroll>
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.collection
          assign img = block.settings.image | default: c.featured_image
          assign label = block.settings.label | default: c.title
          assign url = c.url | default: routes.collections_url
        -%}
        <a class="tile" href="{{ url }}" {{ block.shopify_attributes }}>
          <span class="tile__media">
            {% render 'responsive-image', image: img, sizes: '(min-width: 990px) 16vw, 45vw', max_width: 700 %}
          </span>
          <span class="tile__label">{{ label | default: 'Collection' }}</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection tiles",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "BY TYPE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Shop the collections" },
    { "type": "text", "id": "link_label", "label": "Link label", "default": "View all" },
    { "type": "url", "id": "link_url", "label": "Link", "default": "/collections" },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 3, "max": 6, "step": 1, "default": 6 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "image_picker", "id": "image", "label": "Image override", "info": "Portrait, 3:4. Defaults to the collection image." },
        { "type": "text", "id": "label", "label": "Label override" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection tiles",
      "blocks": [
        { "type": "collection", "settings": { "label": "Necklace Sets" } },
        { "type": "collection", "settings": { "label": "Pendant Sets" } },
        { "type": "collection", "settings": { "label": "Bangles" } },
        { "type": "collection", "settings": { "label": "Bracelets" } },
        { "type": "collection", "settings": { "label": "Earrings" } },
        { "type": "collection", "settings": { "label": "Oxidised Silver" } }
      ]
    }
  ]
}
{% endschema %}
