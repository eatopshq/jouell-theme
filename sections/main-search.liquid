<div class="page-width search-page">
  <h1 class="display display--md">{{ 'search.title' | t }}</h1>

  <form action="{{ routes.search_url }}" method="get" role="search" class="search-page__form">
    <label class="visually-hidden" for="SearchPageInput">{{ 'search.placeholder' | t }}</label>
    <input
      id="SearchPageInput"
      type="search"
      name="q"
      value="{{ search.terms | escape }}"
      placeholder="{{ 'search.placeholder' | t }}"
    >
    <input type="hidden" name="type" value="product">
    <button type="submit" class="text-button">{{ 'search.submit' | t }}</button>
  </form>

  {%- if search.performed -%}
    {%- paginate search.results by 24 -%}
      {%- if search.results_count == 0 -%}
        <p class="search-page__summary">{{ 'search.no_results_html' | t: terms: search.terms }}</p>
      {%- else -%}
        <p class="search-page__summary">{{ 'search.results_for_html' | t: terms: search.terms, count: search.results_count }}</p>
        <div class="product-grid" style="--cols: 4;">
          {%- for result in search.results -%}
            {%- if result.object_type == 'product' -%}
              {% render 'product-card', product: result, show_badge: false %}
            {%- else -%}
              <a class="card card--text" href="{{ result.url }}">
                <h3 class="card__title">{{ result.title }}</h3>
                <p class="lead">{{ result.content | strip_html | truncatewords: 20 }}</p>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <div class="pagination">{{ paginate | default_pagination }}</div>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search results",
  "settings": []
}
{% endschema %}
