<div class="trust section-margin-top">
  <div class="page-width"><div class="trust__inner mobile-scroll" style="--m-col: 62%;" data-mobile-scroll>
    {%- for block in section.blocks -%}
      <div class="trust__item" {{ block.shopify_attributes }}>
        <p class="trust__title">{{ block.settings.title }}</p>
        {%- if block.settings.text != blank -%}<p class="trust__text">{{ block.settings.text }}</p>{%- endif -%}
      </div>
    {%- endfor -%}
  </div></div>
</div>

{% schema %}
{
  "name": "Trust bar",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Gift-ready packaging" },
        { "type": "text", "id": "text", "label": "Text", "default": "Box, pouch and card on every order" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Trust bar",
      "blocks": [
        { "type": "item" },
        { "type": "item", "settings": { "title": "Tarnish-resistant finish", "text": "Plated alloy, sealed and tested" } },
        { "type": "item", "settings": { "title": "Delivered in 3–7 days", "text": "Nationwide, cash on delivery" } },
        { "type": "item", "settings": { "title": "Hassle-free exchanges", "text": "7 days from delivery" } }
      ]
    }
  ]
}
{% endschema %}
