{%- assign s = section.settings -%}

<div class="section-pad-top">
  <div class="page-width">
    <div class="newsletter">
      <div>
        {%- if s.heading != blank -%}<h2 class="h3">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<p class="lead">{{ s.text }}</p>{%- endif -%}
      </div>
      {%- form 'customer', id: 'NewsletterForm', class: 'newsletter__form' -%}
        <input type="hidden" name="contact[tags]" value="newsletter">
        {%- if form.posted_successfully? -%}
          <p class="newsletter__msg" role="status">{{ 'newsletter.success' | t }}</p>
        {%- else -%}
          <div class="newsletter__field">
            <label for="NewsletterEmail" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
            <input
              id="NewsletterEmail"
              type="email"
              name="contact[email]"
              placeholder="{{ 'newsletter.email' | t }}"
              autocomplete="email"
              required
            >
            <button type="submit" class="text-button">{{ 'newsletter.subscribe' | t }}</button>
          </div>
          {%- if form.errors -%}
            <p class="newsletter__msg newsletter__msg--error" role="alert">{{ form.errors | default_errors }}</p>
          {%- endif -%}
        {%- endif -%}
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Before every festive season" },
    { "type": "text", "id": "text", "label": "Text", "default": "New sets, straight to your inbox. One email a month, never more." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
