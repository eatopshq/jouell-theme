<div class="page-width wishlist-page" data-wishlist-page>
  <nav class="breadcrumb" aria-label="{{ 'general.breadcrumb' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a> /
    <span aria-current="page">{{ 'wishlist.title' | t }}</span>
  </nav>
  <h1 class="display display--md">{{ section.settings.heading | default: page.title }}</h1>
  {%- if section.settings.text != blank -%}<p class="lead wishlist-page__intro">{{ section.settings.text }}</p>{%- endif -%}

  <div class="product-grid" style="--cols: 4;" data-wishlist-grid aria-live="polite"></div>

  <div class="empty-state" data-wishlist-empty hidden>
    <p>{{ 'wishlist.empty' | t }}</p>
    <a class="button button--dark" href="{{ routes.all_products_collection_url }}">{{ 'cart.continue' | t }}</a>
  </div>
</div>

{% schema %}
{
  "name": "Wishlist",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your wishlist" },
    { "type": "text", "id": "text", "label": "Text", "default": "Pieces you have saved on this device. Tap the heart on any product to add or remove it." }
  ]
}
{% endschema %}
