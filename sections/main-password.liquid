<div class="password-page">
  {% render 'wordmark', width: 150 %}
  {%- if shop.password_message != blank -%}
    <p class="lead">{{ shop.password_message }}</p>
  {%- else -%}
    <p class="lead">{{ section.settings.text }}</p>
  {%- endif -%}

  {%- form 'customer', class: 'newsletter__form' -%}
    <input type="hidden" name="contact[tags]" value="prospect,password page">
    {%- if form.posted_successfully? -%}
      <p class="newsletter__msg" role="status">{{ 'newsletter.success' | t }}</p>
    {%- else -%}
      <div class="newsletter__field">
        <label for="PasswordNewsletter" class="visually-hidden">{{ 'newsletter.email' | t }}</label>
        <input id="PasswordNewsletter" type="email" name="contact[email]" placeholder="{{ 'newsletter.email' | t }}" required>
        <button type="submit" class="text-button">{{ 'newsletter.subscribe' | t }}</button>
      </div>
    {%- endif -%}
  {%- endform -%}

  <details class="password-page__login">
    <summary>{{ 'password.owner' | t }}</summary>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}{{ form.errors | default_errors }}{%- endif -%}
      <div class="newsletter__field">
        <label for="Password" class="visually-hidden">{{ 'password.password' | t }}</label>
        <input type="password" name="password" id="Password" placeholder="{{ 'password.password' | t }}">
        <button type="submit" class="text-button">{{ 'password.enter' | t }}</button>
      </div>
    {%- endform -%}
  </details>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "text", "id": "text", "label": "Message", "default": "Opening soon — new sets before every festive season." }
  ]
}
{% endschema %}
