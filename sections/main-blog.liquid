<div class="page-width blog">
  <p class="kicker">{{ 'blog.kicker' | t }}</p>
  <h1 class="display display--md">{{ blog.title }}</h1>

  {%- paginate blog.articles by 9 -%}
    <div class="product-grid" style="--cols: 3;">
      {%- for article in blog.articles -%}
        <a class="article-card" href="{{ article.url }}">
          <span class="tile__media" style="--ratio: 4/3;">
            {% render 'responsive-image', image: article.image, sizes: '(min-width: 990px) 33vw, 100vw', max_width: 900 %}
          </span>
          <span class="article-card__date">{{ article.published_at | time_tag: format: 'date' }}</span>
          <span class="h4 article-card__title">{{ article.title }}</span>
          <span class="lead">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</span>
        </a>
      {%- endfor -%}
    </div>
    {%- if paginate.pages > 1 -%}
      <div class="pagination">{{ paginate | default_pagination }}</div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "Blog posts",
  "settings": []
}
{% endschema %}
