{%- liquid
  assign s = section.settings
  case s.ratio
    when 'post'
      assign ratio = '4/5'
    when 'square'
      assign ratio = '1/1'
    else
      assign ratio = '9/16'
  endcase
-%}

<div class="section-pad-top" data-reels>
  <div class="page-width">
    <div class="section-heading">
      <div>
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.text != blank -%}<p class="reels__intro">{{ s.text }}</p>{%- endif -%}
      </div>
      <div class="reels__actions">
        {%- if s.profile_url != blank -%}
          <a class="text-link" href="{{ s.profile_url }}" target="_blank" rel="noopener">
            {{- s.button_label | default: s.handle -}}
          </a>
        {%- endif -%}
        <span class="reels__arrows">
          <button type="button" class="square-button" data-scroll-prev aria-label="{{ 'sections.reels.previous' | t }}">‹</button>
          <button type="button" class="square-button" data-scroll-next aria-label="{{ 'sections.reels.next' | t }}">›</button>
        </span>
      </div>
    </div>

    <div class="reels" style="--reel-ratio: {{ ratio }};" data-scroll-track data-mobile-scroll>
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign p = b.product
          assign link = b.link | default: s.profile_url
        -%}
        <div class="reel" {{ block.shopify_attributes }}>
          <div class="reel__media">
            {%- if b.video != blank -%}
              {{
                b.video
                | video_tag:
                  autoplay: false,
                  muted: true,
                  loop: true,
                  playsinline: true,
                  preload: 'none',
                  image_size: '600x',
                  class: 'reel__video'
              }}
              <span class="reel__badge" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="14" height="14"><path d="M8 5v14l11-7z" fill="currentColor"/></svg>
              </span>
            {%- elsif b.image != blank -%}
              {% render 'responsive-image', image: b.image, sizes: '(min-width: 990px) 20vw, 62vw', max_width: 700 %}
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
          </div>

          {%- if link != blank -%}
            <a
              class="reel__link"
              href="{{ link }}"
              target="_blank"
              rel="noopener"
              aria-label="{{ 'sections.reels.open' | t }}{% if b.caption != blank %}: {{ b.caption | escape }}{% endif %}"
            ></a>
          {%- endif -%}

          <span class="reel__ig" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="0.6" fill="currentColor"/></svg>
          </span>

          {%- if b.caption != blank or p != blank -%}
            <div class="reel__foot">
              {%- if b.caption != blank -%}<p class="reel__caption">{{ b.caption }}</p>{%- endif -%}
              {%- if p != blank -%}
                <a class="reel__product" href="{{ p.url }}">
                  {%- if p.featured_media -%}
                    {{ p.featured_media.preview_image | image_url: width: 96, height: 96, crop: 'center' | image_tag: loading: 'lazy', alt: '' }}
                  {%- endif -%}
                  <span>
                    <span class="reel__product-title">{{ p.title | escape }}</span>
                    <span class="reel__product-price">{{ p.price | money_without_trailing_zeros }}</span>
                  </span>
                </a>
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Instagram reels",
  "max_blocks": 12,
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Seen on Instagram" },
    { "type": "text", "id": "text", "label": "Text", "default": "Real looks from real functions. Tap any reel to watch it on Instagram." },
    { "type": "text", "id": "handle", "label": "Handle", "default": "@jouellindia" },
    { "type": "url", "id": "profile_url", "label": "Instagram profile link", "info": "e.g. https://www.instagram.com/jouellindia/" },
    { "type": "text", "id": "button_label", "label": "Link label", "default": "Follow @jouellindia" },
    {
      "type": "select",
      "id": "ratio",
      "label": "Card shape",
      "options": [
        { "value": "reel", "label": "Reel (9:16)" },
        { "value": "post", "label": "Post (4:5)" },
        { "value": "square", "label": "Square" }
      ],
      "default": "reel"
    },
    {
      "type": "paragraph",
      "content": "Instagram does not let stores load reels directly. Download each reel, upload it under Content → Files, then choose it in the block. Add the reel's link so taps open it on Instagram."
    }
  ],
  "blocks": [
    {
      "type": "reel",
      "name": "Reel or post",
      "settings": [
        { "type": "video", "id": "video", "label": "Video", "info": "An MP4 uploaded to Shopify. Plays silently in a loop when on screen." },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "For a photo post, or used when no video is set." },
        { "type": "url", "id": "link", "label": "Instagram link", "info": "The reel or post URL. Leave empty to link to the profile." },
        { "type": "text", "id": "caption", "label": "Caption" },
        { "type": "product", "id": "product", "label": "Product in this reel", "info": "Adds a Shop this look link." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Instagram reels",
      "blocks": [{ "type": "reel" }, { "type": "reel" }, { "type": "reel" }, { "type": "reel" }, { "type": "reel" }]
    }
  ]
}
{% endschema %}
