{%- liquid
  assign s = section.settings
  # The product's own category: the collection named after its type (e.g. "Bangles"),
  # else its first collection that is not the home page collection
  assign source = nil
  for c in product.collections
    if product.type != blank and c.title contains product.type
      assign source = c
      break
    endif
  endfor
  if source == nil
    for c in product.collections
      unless c.handle == 'frontpage'
        assign source = c
        break
      endunless
    endfor
  endif

  assign shown = 0
-%}

{%- if source != nil and source.products_count > 1 -%}
  <div class="section-pad-top">
    <div class="page-width">
      <div class="section-heading">
        <h2 class="h3">{{ s.heading }}</h2>
        <a class="text-link" href="{{ source.url }}">{{ 'products.see_all_in' | t: name: source.title }}</a>
      </div>
      <div class="product-grid mobile-scroll" style="--cols: 4; --m-col: 64%;" data-mobile-scroll>
        {%- for item in source.products -%}
          {%- if item.id == product.id -%}{%- continue -%}{%- endif -%}
          {%- if shown >= s.limit -%}{%- break -%}{%- endif -%}
          {% render 'product-card', product: item, show_badge: false %}
          {%- assign shown = shown | plus: 1 -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "You may also like",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "You may also like" },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 8, "step": 1, "default": 4 },
    { "type": "paragraph", "content": "Shows other products from the same category as the product being viewed, never the product itself." }
  ],
  "presets": [{ "name": "You may also like" }]
}
{% endschema %}
