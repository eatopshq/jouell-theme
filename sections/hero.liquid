{%- liquid
  assign s = section.settings
  assign slide_count = section.blocks.size
-%}

<div
  class="hero{% if slide_count > 1 %} hero--slides{% endif %}"
  style="--hero-height: {{ s.height }}px; --hero-height-mobile: {{ s.height_mobile }}px; --hero-overlay: {{ s.overlay | divided_by: 100.0 }};"
  data-hero
  data-autoplay="{{ s.autoplay }}"
  data-interval="{{ s.interval }}"
  {% if slide_count > 1 %}
    role="region"
    aria-roledescription="carousel"
    aria-label="{{ 'sections.hero.label' | t }}"
  {% endif %}
>
  <div class="hero__track" data-hero-track>
    {%- for block in section.blocks -%}
      {%- liquid
        assign b = block.settings
        assign eager = false
        if section.index == 1 and forloop.first
          assign eager = true
        endif
        assign heading_tag = 'h2'
      -%}
      <div
        class="hero__slide"
        style="--hero-pos: {{ b.focal | default: 'center 20%' }};"
        data-hero-slide
        {% if slide_count > 1 %}
          role="group"
          aria-roledescription="slide"
          aria-label="{{ forloop.index }} / {{ slide_count }}"
        {% endif %}
        {{ block.shopify_attributes }}
      >
        <div class="hero__media">
          {%- if b.image_mobile != blank -%}
            <picture>
              <source
                media="(max-width: 749px)"
                srcset="{{ b.image_mobile | image_url: width: 750 }} 750w, {{ b.image_mobile | image_url: width: 1100 }} 1100w"
              >
              {% render 'responsive-image', image: b.image, eager: eager, max_width: 2000 %}
            </picture>
          {%- elsif b.image != blank -%}
            {% render 'responsive-image', image: b.image, eager: eager, max_width: 2000 %}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
          {%- endif -%}
        </div>

        <div class="page-width hero__content">
          {%- if b.kicker != blank -%}
            <p class="eyebrow eyebrow--light">{{ b.kicker }}</p>
          {%- endif -%}
          {%- if b.heading != blank -%}
            <{{ heading_tag }} class="hero__heading">{{ b.heading }}</{{ heading_tag }}>
          {%- endif -%}
          {%- if b.text != blank -%}
            <p class="hero__text">{{ b.text }}</p>
          {%- endif -%}
          <div class="hero__buttons">
            {%- if b.button_1_label != blank -%}
              <a href="{{ b.button_1_link | default: routes.all_products_collection_url }}" class="button button--light">
                {{- b.button_1_label -}}
              </a>
            {%- endif -%}
            {%- if b.button_2_label != blank -%}
              <a href="{{ b.button_2_link | default: routes.collections_url }}" class="button button--outline-light">
                {{- b.button_2_label -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if slide_count > 1 -%}
    <div class="page-width hero__controls">
      <div class="hero__dots" role="group" aria-label="{{ 'sections.hero.choose' | t }}">
        {%- for block in section.blocks -%}
          <button
            type="button"
            class="hero__dot"
            data-hero-dot="{{ forloop.index0 }}"
            aria-label="{{ 'sections.hero.go_to' | t: number: forloop.index }}"
            {% if forloop.first %}
              aria-current="true"
            {% endif %}
          ></button>
        {%- endfor -%}
      </div>
      <div class="hero__arrows">
        <button type="button" class="hero__arrow" data-hero-prev aria-label="{{ 'sections.hero.previous' | t }}">‹</button>
        <button type="button" class="hero__arrow" data-hero-next aria-label="{{ 'sections.hero.next' | t }}">›</button>
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Hero slideshow",
  "max_blocks": 4,
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Move to the next slide automatically", "default": true },
    { "type": "range", "id": "interval", "label": "Time per slide", "min": 4, "max": 12, "step": 1, "unit": "s", "default": 6 },
    { "type": "range", "id": "overlay", "label": "Left shade strength", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 75 },
    { "type": "range", "id": "height", "label": "Height (desktop)", "min": 360, "max": 800, "step": 20, "unit": "px", "default": 520 },
    { "type": "range", "id": "height_mobile", "label": "Height (mobile)", "min": 360, "max": 760, "step": 20, "unit": "px", "default": 520 }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "image_picker", "id": "image_mobile", "label": "Mobile image (optional)" },
        {
          "type": "select",
          "id": "focal",
          "label": "Image position",
          "options": [
            { "value": "center top", "label": "Top" },
            { "value": "center 20%", "label": "Upper" },
            { "value": "center center", "label": "Centre" },
            { "value": "center bottom", "label": "Bottom" }
          ],
          "default": "center 20%"
        },
        { "type": "text", "id": "kicker", "label": "Small line above heading", "default": "Shaadi season is here" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "A new look for every function" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Kundan, polki, pearl and oxidised sets for haldi to reception, from ₹840." },
        { "type": "text", "id": "button_1_label", "label": "Button 1 label", "default": "Shop necklace sets" },
        { "type": "url", "id": "button_1_link", "label": "Button 1 link" },
        { "type": "text", "id": "button_2_label", "label": "Button 2 label" },
        { "type": "url", "id": "button_2_link", "label": "Button 2 link" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero slideshow",
      "blocks": [{ "type": "slide" }, { "type": "slide" }]
    }
  ]
}
{% endschema %}
