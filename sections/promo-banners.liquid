<div class="section-pad-top">
  <div class="page-width">
    <div class="promos mobile-scroll" style="--m-col: 86%;" data-mobile-scroll>
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div
          class="promo"
          style="--promo-tint: {{ b.tint | color_modify: 'alpha', 0.9 }}; --promo-kicker: {{ b.kicker_color }}; --promo-btn-bg: {{ b.button_bg }}; --promo-btn-fg: {{ b.button_fg }};"
          {{ block.shopify_attributes }}
        >
          <div class="promo__media">
            {%- if b.image != blank -%}
              {% render 'responsive-image', image: b.image, sizes: '(min-width: 990px) 50vw, 100vw', max_width: 1200 %}
            {%- endif -%}
          </div>
          <div class="promo__content">
            {%- if b.kicker != blank -%}<p class="promo__kicker">{{ b.kicker }}</p>{%- endif -%}
            {%- if b.heading != blank -%}<h3 class="promo__heading">{{ b.heading }}</h3>{%- endif -%}
            {%- if b.text != blank -%}<p class="promo__text">{{ b.text }}</p>{%- endif -%}
            {%- if b.button_label != blank -%}
              <a class="pill" href="{{ b.button_link | default: routes.all_products_collection_url }}">{{ b.button_label }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Promo banners",
  "max_blocks": 2,
  "blocks": [
    {
      "type": "banner",
      "name": "Banner",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Background image" },
        { "type": "color", "id": "tint", "label": "Colour tint", "default": "#263E32" },
        { "type": "color", "id": "kicker_color", "label": "Kicker colour", "default": "#E7C98A" },
        { "type": "text", "id": "kicker", "label": "Kicker", "default": "GIFTING" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Gift box, pouch and a handwritten card" },
        { "type": "text", "id": "text", "label": "Text", "default": "Free on every order. Add your message at checkout." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop gifting" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "color", "id": "button_bg", "label": "Button background", "default": "#C79A4E" },
        { "type": "color", "id": "button_fg", "label": "Button text", "default": "#1A1714" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Promo banners",
      "blocks": [
        { "type": "banner" },
        {
          "type": "banner",
          "settings": {
            "tint": "#92162D",
            "kicker_color": "#F6D9C9",
            "kicker": "THE ₹1,500 EDIT",
            "heading": "Everything under fifteen hundred",
            "text": "Beads, pearls and studs that survive past the wedding week.",
            "button_label": "Shop the edit",
            "button_bg": "#FCFBF8",
            "button_fg": "#92162D"
          }
        }
      ]
    }
  ]
}
{% endschema %}
