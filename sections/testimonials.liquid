{%- assign s = section.settings -%}

<div class="section-pad-top">
  <div class="page-width">
    <div class="section-heading section-heading--bordered">
      <div>
        {%- if s.kicker != blank -%}<p class="kicker">{{ s.kicker }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 class="h2">{{ s.heading }}</h2>{%- endif -%}
      </div>
      {%- if s.rating != blank -%}
        <div class="rating-summary">
          <p class="rating-summary__value">{{ s.rating }}</p>
          <p class="rating-summary__label">{{ s.rating_label }}</p>
        </div>
      {%- endif -%}
    </div>

    <div class="product-grid mobile-scroll" style="--cols: 3; --m-col: 82%;" data-mobile-scroll>
      {%- for block in section.blocks -%}
        {%- liquid
          assign b = block.settings
          assign p = b.product
        -%}
        <figure class="review" {{ block.shopify_attributes }}>
          {%- if b.image != blank or s.show_image_placeholders -%}
            <div class="review__media">
              {% render 'responsive-image', image: b.image, sizes: '(min-width: 990px) 33vw, 82vw', max_width: 900 %}
              {%- if b.occasion != blank -%}
                <span class="review__occasion">{{ b.occasion }}</span>
              {%- endif -%}
            </div>
          {%- endif -%}
          <div class="review__body">
            {% render 'stars', count: b.stars %}
            <blockquote class="review__quote">“{{ b.quote }}”</blockquote>
            <figcaption class="review__author">
              <span class="review__avatar" aria-hidden="true">{{ b.name | slice: 0 | upcase }}</span>
              <span>
                <span class="review__name">{{ b.name }}</span>
                {%- if b.source != blank -%}<span class="review__source">{{ b.source }}</span>{%- endif -%}
              </span>
            </figcaption>
            {%- if p != blank -%}
              <a class="review__product" href="{{ p.url }}">
                {%- if p.featured_media -%}
                  {{ p.featured_media.preview_image | image_url: width: 120, height: 120, crop: 'center' | image_tag: loading: 'lazy', alt: '', class: 'review__thumb' }}
                {%- endif -%}
                <span class="review__product-text">
                  <span class="review__product-title">{{ p.title | escape }}</span>
                  <span class="review__price">{{ p.price | money_without_trailing_zeros }}</span>
                </span>
                <span class="review__arrow" aria-hidden="true">→</span>
              </a>
            {%- endif -%}
          </div>
        </figure>
      {%- endfor -%}
    </div>

    {%- if s.footer_text != blank or s.link_label != blank -%}
      <div class="section-foot">
        <span class="section-foot__text">{{ s.footer_text }}</span>
        {%- if s.link_label != blank -%}
          <a class="text-link" href="{{ s.link_url | default: '#' }}">{{ s.link_label }}</a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Customer photos",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "WORN BY CUSTOMERS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Photographed after the function, not in a studio" },
    { "type": "text", "id": "rating", "label": "Rating", "default": "4.8 / 5" },
    { "type": "text", "id": "rating_label", "label": "Rating label", "default": "from 1,240 verified orders" },
    { "type": "checkbox", "id": "show_image_placeholders", "label": "Show image area when no photo is set", "default": true },
    {
      "type": "inline_richtext",
      "id": "footer_text",
      "label": "Footer text",
      "default": "Tag <strong>@jouellindia</strong> and we'll add your photograph here."
    },
    { "type": "text", "id": "link_label", "label": "Footer link label", "default": "Read all 1,240 reviews" },
    { "type": "url", "id": "link_url", "label": "Footer link" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Customer photo" },
        { "type": "text", "id": "occasion", "label": "Occasion tag", "info": "Shown on the photo, e.g. Worn at a sangeet" },
        { "type": "range", "id": "stars", "label": "Stars", "min": 1, "max": 5, "step": 1, "default": 5 },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Wore it to a wedding with my lehenga and got compliments all night. Worth every rupee."
        },
        { "type": "text", "id": "name", "label": "Name", "default": "Meera Patel" },
        { "type": "text", "id": "source", "label": "Source line", "default": "Verified purchase · via Instagram" },
        { "type": "product", "id": "product", "label": "Product worn" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer photos",
      "blocks": [
        { "type": "review" },
        {
          "type": "review",
          "settings": {
            "quote": "Lightweight and comfortable — I forgot I was wearing it by the end of the sangeet.",
            "name": "Priya Sharma",
            "source": "Verified purchase · via WhatsApp"
          }
        },
        {
          "type": "review",
          "settings": {
            "quote": "Gifted it to my best friend and she loved it — the green beads look rich and royal in person.",
            "name": "Sneha Kapoor",
            "source": "Verified purchase · via Instagram"
          }
        }
      ]
    }
  ]
}
{% endschema %}
