<div class="page-width main-page">
  {%- if section.settings.show_title -%}
    <h1 class="h1 main-page__title">{{ page.title }}</h1>
  {%- endif -%}
  <div class="rte main-page__content">{{ page.content }}</div>
</div>

{% schema %}
{
  "name": "Page content",
  "settings": [
    { "type": "checkbox", "id": "show_title", "label": "Show page title", "default": true }
  ]
}
{% endschema %}
