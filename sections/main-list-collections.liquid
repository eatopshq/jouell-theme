<div class="page-width list-collections">
  <nav class="breadcrumb" aria-label="{{ 'general.breadcrumb' | t }}">
    <a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a> /
    <span aria-current="page">{{ 'collections.title' | t }}</span>
  </nav>
  {%- if section.settings.kicker != blank -%}<p class="kicker">{{ section.settings.kicker }}</p>{%- endif -%}
  {%- assign default_heading = 'collections.title' | t -%}
  <h1 class="display display--md">{{ section.settings.heading | default: default_heading }}</h1>

  <div class="tiles tiles--page" style="--cols: 4;">
    {%- for collection in collections -%}
      {%- if collection.handle == 'frontpage' -%}{%- continue -%}{%- endif -%}
      <a class="tile" href="{{ collection.url }}">
        <span class="tile__media">
          {% render 'responsive-image',
            image: collection.featured_image,
            sizes: '(min-width: 990px) 25vw, 50vw',
            max_width: 800
          %}
        </span>
        <span class="tile__label">{{ collection.title }}</span>
        <span class="tile__count">{{ 'collections.pieces' | t: count: collection.products_count }}</span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Collections list",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "BY TYPE" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "All collections" }
  ]
}
{% endschema %}
