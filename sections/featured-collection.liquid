{%- liquid
  assign s = section.settings
  assign c = s.collection
  assign link_label = s.link_label
  if c != blank and link_label contains '[count]'
    assign link_label = link_label | replace: '[count]', c.products_count
  endif
  case s.ratio
    when 'square'
      assign ratio = '1/1'
    else
      assign ratio = '4/5'
  endcase
-%}

<div class="section-pad-top">
  <div class="page-width">
    {% render 'section-heading',
      kicker: s.kicker,
      heading: s.heading,
      link_label: link_label,
      link_url: c.url,
      bordered: true
    %}

    <div class="product-grid mobile-scroll" style="--cols: {{ s.columns }}; --m-col: 64%;" data-mobile-scroll>
      {%- if c != blank and c.products_count > 0 -%}
        {%- for product in c.products limit: s.limit -%}
          {% render 'product-card', product: product, ratio: ratio, show_badge: s.show_badge %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..s.limit) -%}
          <div class="card">
            <div class="card__media" style="--ratio: {{ ratio }};">
              {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <h3 class="card__title">{{ 'sections.featured_collection.placeholder_title' | t }}</h3>
            <div class="price"><span class="price__current">₹0</span></div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "NECKLACE SETS" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Brilliance meets elegance" },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "All [count] sets",
      "info": "[count] is replaced with the number of products."
    },
    { "type": "range", "id": "limit", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns (desktop)", "min": 2, "max": 5, "step": 1, "default": 4 },
    {
      "type": "select",
      "id": "ratio",
      "label": "Image shape",
      "options": [
        { "value": "portrait", "label": "Portrait 4:5" },
        { "value": "square", "label": "Square" }
      ],
      "default": "portrait"
    },
    { "type": "checkbox", "id": "show_badge", "label": "Show weight · style label", "default": true }
  ],
  "presets": [{ "name": "Featured collection" }]
}
{% endschema %}
